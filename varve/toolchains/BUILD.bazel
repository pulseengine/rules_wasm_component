"""Registers loom/meld/spar/synth/witness/wasm-tools/wkg/wit-bindgen-wrpc
toolchains sourced from varve's `covalent` realm (one pin, //:varve.toml,
composing the `pulseengine` and `pulseengine-wasm` realms — see
//:varve-realms.toml and `varve docs composition`) instead of this repo's
own per-tool GitHub-release download, backed by checksums/tools/*.json.

Each `<tool>_toolchain` rule (loaded from its existing definition — this file
adds no new rule types) is generic: it takes file-label attrs and wraps them
in the existing ToolchainInfo. The only thing that changes is where those
files come from: `@varve_tools//:<tool>`, resolved and signature-verified by
varve against the trust root in //:covalent.pub, rather than a
checksum_updater-tracked, trust-on-first-use GitHub release asset.

Composing does not widen trust: loom/meld/spar/synth/witness verify against
`pulseengine`'s root, wasm-tools/wkg/wit-bindgen-wrpc against
`pulseengine-wasm`'s — each independently, per //:varve-realms.toml. Only
wasm-tools of the pulseengine-wasm set carries upstream proof of origin;
wkg/wit-bindgen-wrpc do not (see //:varve.toml's header). Read `varve
inspect` on the pinned layer before treating those the same as the
pulseengine realm's build-provenance-backed tools.

wac is in the pulseengine-wasm realm too but DELIBERATELY NOT sourced from
it here: the realm's only published layer carries wac 0.11.0, but
toolchains/tool_versions.bzl pins wac at 0.9.0 specifically because it
"does NOT support P3 async yet (issue #180)" — 0.11.0 rejects the WASI P3
dual-compile composition outright ("the async canonical option requires an
async function type"), caught by this repo's own CI. wac stays on
`@wasm_tools_toolchains//:wac_binary` (the existing pinned download) until
either P3 composition is updated for newer wac or the realm publishes a
compatible version.

wit_bindgen (plain), wrpc (plain), and wasmsign2 are likewise not in the
pulseengine-wasm realm and come from the existing `@wasm_tools_toolchains`
repo (//wasm:extensions.bzl's wasm_toolchain extension).

varve ships no Windows binary (checked: only the 4 unix triples exist in its
releases — tracked upstream). So EVERY toolchain in this file is
exec-platform-conditional: varve on linux/macos (two `toolchain()`
registrations each, since `exec_compatible_with` is a single constraint set,
not an OR), the tool's own untouched old-download toolchain — still
registered via its original per-tool extension in MODULE.bazel — as the
Windows (and any other unlisted OS) fallback. Toolchain resolution picks the
first *matching* registration in registration order, so MODULE.bazel MUST
register the linux/macos pair before the unconstrained fallback for each
tool, or the fallback would win everywhere and the varve switch would be a
no-op.

`wsc` (the signing toolchain) and `rivet` are deliberately NOT here: wsc sits
on the signing path and needs its own explicit review before its trust source
changes; rivet has no existing rules_wasm_component toolchain to replace.
"""

load("@rules_wasm_component//toolchains:loom_toolchain.bzl", "loom_toolchain")
load("@rules_wasm_component//toolchains:meld_toolchain.bzl", "meld_toolchain")
load("@rules_wasm_component//toolchains:spar_toolchain.bzl", "spar_toolchain")
load("@rules_wasm_component//toolchains:synth_toolchain.bzl", "synth_toolchain")
load("@rules_wasm_component//toolchains:wasm_toolchain.bzl", "wasm_tools_toolchain")
load("@rules_wasm_component//toolchains:witness_toolchain.bzl", "witness_toolchain")
load("@rules_wasm_component//toolchains:wkg_toolchain.bzl", "wkg_toolchain")
load("//varve/toolchains:varve_toolchain_pair.bzl", "varve_toolchain_pair")

package(default_visibility = ["//visibility:public"])

varve_toolchain_pair(
    name = "loom_toolchain",
    loom = "@varve_tools//:loom",
    rule = loom_toolchain,
    toolchain_type = "@rules_wasm_component//toolchains:loom_toolchain_type",
)

varve_toolchain_pair(
    name = "meld_toolchain",
    meld = "@varve_tools//:meld",
    rule = meld_toolchain,
    toolchain_type = "@rules_wasm_component//toolchains:meld_toolchain_type",
)

varve_toolchain_pair(
    name = "spar_toolchain",
    rule = spar_toolchain,
    spar = "@varve_tools//:spar",
    toolchain_type = "@rules_wasm_component//toolchains:spar_toolchain_type",
)

varve_toolchain_pair(
    name = "synth_toolchain",
    rule = synth_toolchain,
    synth = "@varve_tools//:synth",
    toolchain_type = "@rules_wasm_component//toolchains:synth_toolchain_type",
)

varve_toolchain_pair(
    name = "witness_toolchain",
    rule = witness_toolchain,
    toolchain_type = "@rules_wasm_component//toolchains:witness_toolchain_type",
    witness = "@varve_tools//:witness",
)

# wasm_tools_toolchain mixes varve-sourced (wasm_tools, wit_bindgen_wrpc)
# with the existing download path (wac — pinned at 0.9.0 for P3 async
# compatibility, see the file docstring; wit_bindgen, wrpc, wasmsign2 — not
# in the pulseengine-wasm realm). @wasm_tools_toolchains is generated by
# //wasm:extensions.bzl's wasm_toolchain extension; it still downloads
# wasm-tools/wit-bindgen-wrpc itself too (its own bundled toolchain is just
# never registered on linux/macos), which is dead-but-harmless work, not a
# correctness or trust concern.
varve_toolchain_pair(
    name = "wasm_tools_toolchain",
    rule = wasm_tools_toolchain,
    toolchain_type = "@rules_wasm_component//toolchains:wasm_tools_toolchain_type",
    wac = "@wasm_tools_toolchains//:wac_binary",
    wasm_tools = "@varve_tools//:wasm-tools",
    wasmsign2 = "@wasm_tools_toolchains//:wasmsign2_binary",
    wit_bindgen = "@wasm_tools_toolchains//:wit_bindgen_binary",
    wit_bindgen_wrpc = "@varve_tools//:wit-bindgen-wrpc",
    wrpc = "@wasm_tools_toolchains//:wrpc_binary",
)

varve_toolchain_pair(
    name = "wkg_toolchain",
    rule = wkg_toolchain,
    toolchain_type = "@rules_wasm_component//toolchains:wkg_toolchain_type",
    wkg = "@varve_tools//:wkg",
)
