package(default_visibility = ["//visibility:public"])

exports_files([
    "varve.toml",
    "rolling.pub",
])

# The layer's tools, resolved and signature-verified by varve, consumable
# as ordinary Bazel targets. All six PulseEngine tools this repo's own
# checksum_updater currently hand-manages (checksums/tools/{loom,meld,spar,
# synth,witness,wsc}.json) are in this layer too — see rules_wasm_component
# issue about reducing that duplication once varve is trusted for it.
[
    alias(
        name = tool,
        actual = "@varve_tools//:" + tool,
    )
    for tool in [
        "loom",
        "meld",
        "rivet",
        "spar",
        "synth",
        "witness",
        "wsc",
    ]
]
