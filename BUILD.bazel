"""Root BUILD file for rules_wasm_component"""

load("@buildifier_prebuilt//:rules.bzl", "buildifier")

package(default_visibility = ["//visibility:public"])

# Test suite for wit-bindgen-rt fix validation
# Aggregates alignment tests and integration tests that validate the fix
test_suite(
    name = "wit_bindgen_rt_validation",
    tests = [
        "//test/alignment:alignment_tests",
        "//test/integration:wit_bindgen_rt_fix_test",
    ],
)

# Export all rule files
exports_files([
    "LICENSE",
    "README.md",
])

# Buildifier for formatting. `bazel run //:buildifier` FIXES files in place;
# the runner script ignores arguments, so `-- --mode=check` does not turn it
# into a check (CI used it that way and could never fail).
buildifier(
    name = "buildifier",
    diff_command = "diff -u",
    mode = "fix",
)

# What CI runs: reports unformatted files and exits non-zero, changes nothing.
# ci-controls/ holds planted bad inputs and is excluded.
buildifier(
    name = "buildifier_check",
    exclude_patterns = ["./ci-controls/*"],
    mode = "check",
)

# Informational lint warnings (CI does not gate on them).
buildifier(
    name = "buildifier_lint_warn",
    exclude_patterns = ["./ci-controls/*"],
    lint_mode = "warn",
    mode = "check",
)

# Documentation generation
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*/**",
            ".git/**",
        ],
    ),
)

# Version file for stamping
genrule(
    name = "version",
    outs = ["version.txt"],
    cmd = "echo '0.1.0' > $@",
    visibility = ["//visibility:public"],
)

# Clippy linting for all Rust code - replaces scripts/clippy.sh
# Usage: bazel build //:clippy (runs clippy on all Rust targets)
alias(
    name = "clippy",
    actual = "//test/clippy:test_lib_clippy",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "test_archive",
    srcs = ["test_cpp_archive.cpp"],
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
)
