# loom/meld/spar/synth/witness/wasm-tools/wkg/wit-bindgen-wrpc, sourced
# from varve's `covalent` realm — ONE pin (//:varve.toml) composing the
# `pulseengine` realm (PulseEngine's own tools) and `pulseengine-wasm`
# realm (bytecodealliance-origin tools, signed by a separate PulseEngine
# key) into a single signed, counter-protected, dated layer. Each composed
# half still verifies against its OWN realm's root — covalent's root signs
# only the pairing, never the bytes (`varve docs composition`). Realm
# definitions, including covalent's own root, live in //:varve-realms.toml
# — required for the composition walk to resolve pulseengine and
# pulseengine-wasm, not read directly by this extension. See
# //varve/README.md for the trust model and //varve/toolchains:BUILD.bazel
# for the toolchain wiring.
#
# wac is DELIBERATELY NOT in `tools`, even though covalent carries it:
# toolchains/tool_versions.bzl pins wac at 0.9.0 specifically because
# "wac 0.9.0 does NOT support P3 async yet (issue #180)" — the
# pulseengine-wasm realm's only published wac (0.11.0) rejects the WASI P3
# dual-compile composition (examples/rust_p3/p3_cli, actively developed)
# with "the async canonical option requires an async function type".
# Caught by this repo's own CI (Direct Integration Test), not assumed.
# wac stays on the old download path (still pinned at 0.9.0) until either
# P3 composition is updated for newer wac or the realm publishes a
# compatible version.
#
# wit-bindgen (plain), wasmtime, wasi-sdk, binaryen, and wrpc (non-wrpc-
# bindgen) are NOT in either composed realm and stay on their existing
# paths. wsc (signing toolchain) and rivet stay on their existing paths
# too — wsc deliberately: a signing-path trust-source change needs its
# own explicit review, not a bundled one.
varve = use_extension("//varve:varve.bzl", "varve")
varve.configure(
    pin = "//:varve.toml",
    realms = "//:varve-realms.toml",
    registry = "oci://ghcr.io/pulseengine/covalent-layers",
    tools = [
        "loom",
        "meld",
        "spar",
        "synth",
        "wasm-tools",
        "wit-bindgen-wrpc",
        "witness",
        "wkg",
    ],
    trust_root = "//:covalent.pub",
)
use_repo(varve, "varve_tools")

# Order matters: toolchain resolution picks the first *matching*
# registration for the current exec platform. The linux/macos varve-backed
# toolchains must come before the unconstrained (exec_compatible_with = [])
# old-download fallbacks, or the fallback would win everywhere and the
# varve switch would be a no-op.
register_toolchains(
    "//varve/toolchains:loom_toolchain_linux",
    "//varve/toolchains:loom_toolchain_macos",
    "@loom_toolchain//:loom_toolchain",  # Windows fallback
    "//varve/toolchains:meld_toolchain_linux",
    "//varve/toolchains:meld_toolchain_macos",
    "@meld_toolchain//:meld_toolchain",  # Windows fallback
    "//varve/toolchains:spar_toolchain_linux",
    "//varve/toolchains:spar_toolchain_macos",
    "@spar_toolchain//:spar_toolchain",  # Windows fallback
    "//varve/toolchains:synth_toolchain_linux",
    "//varve/toolchains:synth_toolchain_macos",
    "@synth_toolchain//:synth_toolchain",  # Windows fallback
    "//varve/toolchains:witness_toolchain_linux",
    "//varve/toolchains:witness_toolchain_macos",
    "@witness_toolchain//:witness_toolchain",  # Windows fallback
    "//varve/toolchains:wasm_tools_toolchain_linux",
    "//varve/toolchains:wasm_tools_toolchain_macos",
    "@wasm_tools_toolchains//:wasm_tools_toolchain",  # Windows fallback
    "//varve/toolchains:wkg_toolchain_linux",
    "//varve/toolchains:wkg_toolchain_macos",
    "@wkg_toolchain//:wkg_toolchain_def",  # Windows fallback
)

